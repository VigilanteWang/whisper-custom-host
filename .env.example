# 将本文件复制为 .env 后可覆盖默认值；.env 不会进入 Git。
# 本文件会被 Bash source，等号两侧不要加空格。
# WHISPER_INSTALL_ROOT 默认由本配置文件所在目录推导，因此仓库移动后无需改路径。
# 直接 source 本文件时也能得到正确的仓库根目录。
_WHISPER_CONFIG_FILE="${BASH_SOURCE[0]}"
_WHISPER_CONFIG_DIR="$(cd "$(dirname "${_WHISPER_CONFIG_FILE}")" && pwd -P)"
WHISPER_INSTALL_ROOT="${WHISPER_INSTALL_ROOT:-${_WHISPER_CONFIG_DIR}}"
unset _WHISPER_CONFIG_FILE _WHISPER_CONFIG_DIR

# 固定到调研文档指定的稳定版本，同时固定 commit，防止 tag 被意外移动。
WHISPER_TAG="${WHISPER_TAG:-v1.9.2}"
WHISPER_COMMIT="${WHISPER_COMMIT:-306c88f4d1286aec1bf96e544632897886af5501}"

WHISPER_MODEL="${WHISPER_MODEL:-large-v3-turbo}"
WHISPER_MODEL_SHA256="${WHISPER_MODEL_SHA256:-1fc70f774d38eb169993ac391eea357ef47c88757ef72ee5943879b7e8e2bc69}"
WHISPER_MODEL_SIZE_BYTES="${WHISPER_MODEL_SIZE_BYTES:-1624555275}"

# 0.0.0.0 表示监听所有本机网络接口，只应在可信局域网使用。
WHISPER_HOST="${WHISPER_HOST:-0.0.0.0}"
WHISPER_PORT="${WHISPER_PORT:-8080}"
WHISPER_INFERENCE_PATH="${WHISPER_INFERENCE_PATH:-/v1/audio/transcriptions}"
WHISPER_LANGUAGE="${WHISPER_LANGUAGE:-auto}"
WHISPER_THREADS="${WHISPER_THREADS:-4}"

# LAN 客户端访问服务时使用的主机名或 IP。默认动态读取当前 macOS 的本地主机名；
# 如果局域网 DNS/Bonjour 不使用这个名字，请在 .env 中改成服务端 LAN IP。
WHISPER_LAN_HOST="${WHISPER_LAN_HOST:-$(/usr/sbin/scutil --get LocalHostName 2>/dev/null || /bin/hostname -s)}"

# 仅供未来 launchd/LaunchDaemon 方案使用；默认是当前登录用户，不要把真实用户名写进仓库。
WHISPER_SERVICE_USER="${WHISPER_SERVICE_USER:-$(/usr/bin/id -un)}"

# 已有最小权限防火墙 helper 的路径；留在默认值即可，也可在 .env 中覆盖。
WHISPER_FIREWALL_HELPER="${WHISPER_FIREWALL_HELPER:-/usr/local/sbin/whisper-host-admin}"

# 控制端 SSH/Wake-on-LAN 配置。WOL 的广播地址和目标 MAC 必须由部署者填写；
# 不要把真实 MAC、用户名、主机名或私钥写入此模板。
WHISPER_SSH_ALIAS="${WHISPER_SSH_ALIAS:-macmini-m4}"
WHISPER_SSH_HOST="${WHISPER_SSH_HOST:-${WHISPER_LAN_HOST}}"
WHISPER_SSH_USER="${WHISPER_SSH_USER:-${WHISPER_SERVICE_USER}}"
WHISPER_SSH_PORT="${WHISPER_SSH_PORT:-22}"
WHISPER_SSH_IDENTITY_FILE="${WHISPER_SSH_IDENTITY_FILE:-${HOME}/.ssh/macmini-m4-ed25519}"
WHISPER_SSH_CONFIG_FILE="${WHISPER_SSH_CONFIG_FILE:-${HOME}/.ssh/config}"
WHISPER_SSH_CONFIG_FRAGMENT="${WHISPER_SSH_CONFIG_FRAGMENT:-${HOME}/.ssh/config.d/whisper-custom-host.conf}"
WHISPER_WOL_PROXY_FILE="${WHISPER_WOL_PROXY_FILE:-${HOME}/.ssh/macmini-m4-wake-proxy}"
WHISPER_WOL_BROADCAST="${WHISPER_WOL_BROADCAST:-}"
WHISPER_WOL_MAC="${WHISPER_WOL_MAC:-}"
WHISPER_SSH_CONNECT_TIMEOUT="${WHISPER_SSH_CONNECT_TIMEOUT:-40}"
WHISPER_SSH_ALIVE_INTERVAL="${WHISPER_SSH_ALIVE_INTERVAL:-30}"
WHISPER_SSH_ALIVE_COUNT_MAX="${WHISPER_SSH_ALIVE_COUNT_MAX:-3}"
WHISPER_WOL_WAIT_SECONDS="${WHISPER_WOL_WAIT_SECONDS:-30}"
WHISPER_WOL_SEND_COUNT="${WHISPER_WOL_SEND_COUNT:-5}"
